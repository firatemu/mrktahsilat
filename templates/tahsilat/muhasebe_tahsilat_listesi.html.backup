    }

    .table-compact .col-tutar {
        width: 8% !important;
        text-align: center !important; /* Başlık ortalı */
        font-weight: bold;
    }

    /* Taksit ve Tutar kolonları için sağa dayalı hizalama */
    .table-compact tbody tr td:nth-child(8), /* Taksit kolonu */
    .table-compact tbody tr td:nth-child(9) { /* Tutar kolonu */
        text-align: right !important;
    }

    .table-compact .col-plasiyer {
        width: 7% !important;
        text-align: center !important;
    }

    .table-compact .col-durum {
        width: 11% !important;
        text-align: center !important;
    }

    .table-compact .col-kullanici {
        width: 5% !important;
        text-align: center !important;
    }

    .table-compact .col-ekleme-tarihi {
        width: 7% !important;
        text-align: center !important;
        font-size: 0.9rem !important;
    }

    .table-compact .col-teslim-durumu {
        width: 9% !important;
