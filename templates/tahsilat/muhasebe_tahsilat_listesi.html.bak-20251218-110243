<script>
    document.addEventListener('DOMContentLoaded', function () {
        // Filtreleme butonları
        const filterButtons = document.querySelectorAll('.filter-btn');

        // Buton click event'leri
        filterButtons.forEach(button => {
            button.addEventListener('click', function () {
                // Aktif butonu değiştir
                filterButtons.forEach(btn => btn.classList.remove('active'));
                this.classList.add('active');

                // Backend'e tarih aralığı parametreleri ile yönlendir
                const filterType = this.getAttribute('data-filter');
                const currentUrl = new URL(window.location);

                // Quick ranges: set baslangic_tarihi and bitis_tarihi
                const today = new Date();
                function toISODate(d) { return d.toISOString().slice(0,10); }

                if (filterType === 'all') {
                    currentUrl.searchParams.delete('baslangic_tarihi');
                    currentUrl.searchParams.delete('bitis_tarihi');
                } else if (filterType === 'today') {
                    const d = toISODate(today);
                    currentUrl.searchParams.set('baslangic_tarihi', d);
                    currentUrl.searchParams.set('bitis_tarihi', d);
                } else if (filterType === 'week') {
                    const first = new Date(today);
                    // hafta başı = pazartesi
                    const day = (today.getDay() + 6) % 7; // 0->6
                    first.setDate(today.getDate() - day);
                    const last = new Date(first);
                    last.setDate(first.getDate() + 6);
                    currentUrl.searchParams.set('baslangic_tarihi', toISODate(first));
                    currentUrl.searchParams.set('bitis_tarihi', toISODate(last));
                } else if (filterType === 'month') {
                    const first = new Date(today.getFullYear(), today.getMonth(), 1);
                    const last = new Date(today.getFullYear(), today.getMonth() + 1, 0);
                    currentUrl.searchParams.set('baslangic_tarihi', toISODate(first));
                    currentUrl.searchParams.set('bitis_tarihi', toISODate(last));
                }

                // Remove old single param if present
                currentUrl.searchParams.delete('tarih_filtresi');
                currentUrl.searchParams.set('page', '1'); // İlk sayfaya dön

                // Sayfayı yeniden yükle
                window.location.href = currentUrl.toString();
            });
        });

        // Sayfa yüklendiğinde quick-range butonlarını URL paramlarına göre işaretle
        (function markActiveFilterFromParams(){
            try {
                const params = new URL(window.location).searchParams;
                const s = params.get('baslangic_tarihi');
                const e = params.get('bitis_tarihi');
                if (!s && !e) {
                    // default -> all
                    const btn = document.querySelector('.filter-btn[data-filter="all"]');
                    if (btn) btn.classList.add('active');
                    return;
                }
                const start = s ? new Date(s) : null;
                const end = e ? new Date(e) : null;
                const today = new Date();
                const isToday = start && end && start.toISOString().slice(0,10) === today.toISOString().slice(0,10) && end.toISOString().slice(0,10) === today.toISOString().slice(0,10);
                if (isToday) {
                    const btn = document.querySelector('.filter-btn[data-filter="today"]'); if (btn) btn.classList.add('active'); return;
                }
                if (start && end) {
                    // week
                    const diff = (end - start) / (24*3600*1000);
                    if (diff === 6 && start.getDate() === (new Date(start.getFullYear(), start.getMonth(), start.getDate())).getDate()) {
                        const btn = document.querySelector('.filter-btn[data-filter="week"]'); if (btn) btn.classList.add('active'); return;
                    }
                    // month (rough) -> same month
                    if (start.getMonth() === end.getMonth() && start.getFullYear() === end.getFullYear()) {
                        const btn = document.querySelector('.filter-btn[data-filter="month"]'); if (btn) btn.classList.add('active'); return;
                    }
                }
            } catch (e) { /* no-op */ }
        })();
    });

    // Evrak görüntüleme fonksiyonu
