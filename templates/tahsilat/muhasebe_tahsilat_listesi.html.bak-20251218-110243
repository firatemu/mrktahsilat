    .fatura-cari { color: #212529; min-width: 0; }
    .fatura-cari-name { font-weight: 600; margin-bottom: 0.15rem; line-height: 1.2; }
    .fatura-cari-details { font-size: 0.8rem; color: #6c757d; }
