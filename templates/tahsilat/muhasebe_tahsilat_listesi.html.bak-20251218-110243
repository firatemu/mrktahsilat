                } else if (teslimDurumu === 'TESLİM EDİLMEDİ') {
                    teslimDurumuCell.classList.add('teslim-edilmedi-text');
                    teslimDurumuCell.style.color = '#dc3545'; // Kırmızı
                    teslimDurumuCell.style.fontWeight = 'bold';
                    console.log('TESLİM EDİLMEDİ - Kırmızı class eklendi');
                } else if (teslimDurumu === 'HESAP GÖRÜLDÜ') {
                    teslimDurumuCell.classList.add('hesap-goruldu-text');
                    teslimDurumuCell.style.color = '#0dcaf0'; // Mavi
                    teslimDurumuCell.style.fontWeight = 'normal';
                    console.log('HESAP GÖRÜLDÜ - Mavi class eklendi');
                } else if (teslimDurumu === "LOGO'DA İŞLENDİ") {
                    teslimDurumuCell.classList.add('logo-islendi-text');
                    teslimDurumuCell.style.color = '#6f42c1'; // Mor
                    teslimDurumuCell.style.fontWeight = 'normal';
                    console.log('LOGO\'DA İŞLENDİ - Mor class eklendi');
                } else if (teslimDurumu === 'BEKLEMEDE') {
                    teslimDurumuCell.classList.add('beklemede-text');
                    teslimDurumuCell.style.color = '#fd7e14'; // Turuncu
                    teslimDurumuCell.style.fontWeight = 'normal';
                    console.log('BEKLEMEDE - Turuncu class eklendi');
                } else if (teslimDurumu === 'İPTAL') {
                    teslimDurumuCell.classList.add('iptal-text');
                    teslimDurumuCell.style.color = '#dc3545'; // Kırmızı
                    teslimDurumuCell.style.fontWeight = 'bold';
                    console.log('İPTAL - Kırmızı class eklendi');
                } else {
                    // Diğer durumlar için varsayılan siyah
                    teslimDurumuCell.style.color = '#000000'; // Siyah
                    teslimDurumuCell.style.fontWeight = 'normal';
                    console.log('Diğer durum - Siyah:', teslimDurumu);
                }
            }

            // Sağ tuş event listener ekle
            row.addEventListener('contextmenu', function(e) {
                const checkbox = row.querySelector('.tahsilat-checkbox');
                if (checkbox) {
                    const tahsilatId = checkbox.value;
                    const teslimDurumu = teslimDurumuCell ? teslimDurumuCell.textContent.trim() : '';
                    showContextMenu(e, tahsilatId, teslimDurumu, row);
