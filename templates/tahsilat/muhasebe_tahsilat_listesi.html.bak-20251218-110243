        formData.append('tahsilat_id', tahsilatId);

        // AJAX ile silme isteği gönder
        csrfFetch('/sil/', {
            method: 'POST',
            body: formData
        })
            .then(response => response.json())
            .then(data => {
                if (data.success) {
                    // Backend'den gelen mesajı göster (evrak bilgisi içerir)
                    alert(data.message || 'Tahsilat başarıyla silindi!');
                    // Sayfayı yenile
                    location.reload();
                } else {
                    alert('Silme hatası: ' + (data.error || 'Bilinmeyen hata'));
                }
            })
            .catch(error => {
                console.error('Error:', error);
                alert('Sunucu hatası oluştu');
            });
    }

    // Sağ tuş menüsü fonksiyonları
    function showContextMenu(event, tahsilatId, teslimDurumu, row) {
        event.preventDefault();
        
        // Mevcut menüyü kaldır
        const existingMenu = document.getElementById('contextMenu');
        if (existingMenu) {
            existingMenu.remove();
        }

        // Yeni menü oluştur
        const menu = document.createElement('div');
        menu.id = 'contextMenu';
        menu.className = 'context-menu';
        menu.style.position = 'fixed';
        menu.style.zIndex = '9999';
        menu.style.backgroundColor = 'white';
        menu.style.border = '1px solid #dee2e6';
        menu.style.borderRadius = '8px';
        menu.style.boxShadow = '0 4px 12px rgba(0,0,0,0.15)';
        menu.style.padding = '8px 0';
        menu.style.minWidth = '200px';
        menu.style.visibility = 'hidden';

        // Menü öğeleri
        const menuItems = [];

        // 1) Logo'da İşlendi Yap - sadece Durum "İŞLENMEDİ" ise göster
        try {
            const durumCell = row.querySelector('td:nth-child(11)'); // Durum kolonu
            const logoDurum = (durumCell ? durumCell.textContent : '').trim().toUpperCase();
            if (logoDurum === 'İŞLENMEDİ' || logoDurum === 'ISLENMEDI') { // Türkçe/ing klavye olası varyasyonları
                menuItems.push({
                    text: "Logo'da İşlendi Yap",
                    icon: 'bi-check-circle',
                    color: 'text-success',
                    action: () => updateLogoDurumu(tahsilatId)
                });
            }
        } catch (e) { /* no-op */ }

        // 2) Teslim Edildi Yap - sadece TESLİM EDİLMEDİ durumunda ve kullanıcı yetkisi kontrolü
        if (teslimDurumu === 'TESLİM EDİLMEDİ') {
            // FIRAT kullanıcısı herkesin kayıtlarını teslim edildi yapabilir
            // Diğer kullanıcılar sadece kendi kayıtlarını teslim edildi yapabilir
            const currentUser = '{{ current_user|upper }}';
            const tahsilatKullanici = row.querySelector('td:nth-child(12)').textContent.trim().toUpperCase(); // Kullanıcı kolonu
            
            if (currentUser === 'FIRAT' || currentUser === tahsilatKullanici) {
                menuItems.push({
                    text: 'Teslim Edildi Yap',
                    icon: 'bi-check-circle',
                    color: 'text-success',
                    action: () => updateSingleTeslimDurumu(tahsilatId, 'TESLİM EDİLDİ')
                });
            }
        }

        // Hesap Görüldü Yap - sadece TESLİM EDİLDİ durumunda ve sadece MERT/FIRAT kullanıcıları
        if (teslimDurumu === 'TESLİM EDİLDİ' && ('{{ user.username|upper }}' === 'MERT' || '{{ user.username|upper }}' === 'FIRAT')) {
            menuItems.push({
                text: 'Hesap Görüldü Yap',
                icon: 'bi-eye',
                color: 'text-info',
                action: () => updateSelectedRecordsStatus('HESAP GÖRÜLDÜ')
            });
        }

        // Menü öğelerini ekle
        menuItems.forEach(item => {
            const menuItem = document.createElement('div');
            menuItem.className = 'context-menu-item';
            menuItem.style.padding = '8px 16px';
            menuItem.style.cursor = 'pointer';
            menuItem.style.display = 'flex';
            menuItem.style.alignItems = 'center';
            menuItem.innerHTML = `
                <i class="bi ${item.icon} me-2 ${item.color}"></i>
                <span>${item.text}</span>
            `;
            
            menuItem.addEventListener('mouseenter', () => {
                menuItem.style.backgroundColor = '#f8f9fa';
            });
            
            menuItem.addEventListener('mouseleave', () => {
                menuItem.style.backgroundColor = 'transparent';
            });
            
            menuItem.addEventListener('click', () => {
                item.action();
                menu.remove();
            });
            
            menu.appendChild(menuItem);
        });

        // Eğer menü öğesi yoksa
        if (menuItems.length === 0) {
            const menuItem = document.createElement('div');
            menuItem.style.padding = '8px 16px';
            menuItem.style.color = '#6c757d';
            menuItem.innerHTML = '<i class="bi bi-info-circle me-2"></i>Bu kayıt için işlem yapılamaz';
            menu.appendChild(menuItem);
        }

        document.body.appendChild(menu);

        // Menü boyutunu al ve pozisyonu ayarla
        const menuRect = menu.getBoundingClientRect();
        const viewportWidth = window.innerWidth;
        const viewportHeight = window.innerHeight;
        
        let menuX = event.clientX;
        let menuY = event.clientY;
        
        // Sağa taşma kontrolü
        if (menuX + menuRect.width > viewportWidth) {
            menuX = viewportWidth - menuRect.width - 10;
        }
        
        // Alta taşma kontrolü
        if (menuY + menuRect.height > viewportHeight) {
            menuY = viewportHeight - menuRect.height - 10;
        }
        
        // Sol ve üst sınır kontrolü
        menuX = Math.max(10, menuX);
        menuY = Math.max(10, menuY);
        
        // Pozisyonu ayarla ve görünür yap
        menu.style.left = menuX + 'px';
        menu.style.top = menuY + 'px';
        menu.style.visibility = 'visible';

        // Menü dışına tıklandığında kapat
        const closeMenu = (e) => {
            if (!menu.contains(e.target)) {
                menu.remove();
                document.removeEventListener('click', closeMenu);
            }
        };
        
        setTimeout(() => {
            document.addEventListener('click', closeMenu);
        }, 100);
    }

