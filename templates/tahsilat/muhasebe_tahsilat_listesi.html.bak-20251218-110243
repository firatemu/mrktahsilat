{% block content %}
<!-- Gizli CSRF form -->
<form id="csrf-form" style="display: none;">
    {% csrf_token %}
</form>

<!-- CSRF ve Helper Fonksiyonları - Global Scope'ta -->
<script>
    // Django CSRF token'ını global olarak erişilebilir yap
    window.csrfToken = '{{ csrf_token }}';
    
    // AJAX istekleri için CSRF token'ı otomatik ekle
    function getCookie(name) {
        let cookieValue = null;
        if (document.cookie && document.cookie !== '') {
            const cookies = document.cookie.split(';');
            for (let i = 0; i < cookies.length; i++) {
                const cookie = cookies[i].trim();
                if (cookie.substring(0, name.length + 1) === (name + '=')) {
                    cookieValue = decodeURIComponent(cookie.substring(name.length + 1));
                    break;
                }
            }
        }
        return cookieValue;
    }
    
    // CSRF token'ı cookie'den al
    const csrftoken = getCookie('csrftoken');
    if (csrftoken) {
        window.csrfToken = csrftoken;
    }
    
    // HTTP metod kontrolü - hangi metodlar CSRF token gerektirmez
    function csrfSafeMethod(method) {
        return (/^(GET|HEAD|OPTIONS|TRACE)$/.test(method));
    }
    
    // jQuery AJAX setup (eğer jQuery kullanılıyorsa)
    if (typeof $ !== 'undefined') {
        $.ajaxSetup({
            beforeSend: function(xhr, settings) {
                if (!csrfSafeMethod(settings.type) && !this.crossDomain) {
                    xhr.setRequestHeader("X-CSRFToken", window.csrfToken);
                }
            }
        });
    }
    
    // Fetch API için CSRF token wrapper - Global scope
    window.csrfFetch = function(url, options = {}) {
        const method = options.method || 'GET';
        
        if (!csrfSafeMethod(method)) {
            options.headers = options.headers || {};
            // Ensure token is defined via window.csrfToken or fallback to cookie
            const token = window.csrfToken || getCookie('csrftoken');
            if (token) {
                options.headers['X-CSRFToken'] = token;
            }
        }
        
        return fetch(url, options);
    };
</script>

<div class="container-fluid main-content">
    <div class="row mb-4">
        <div class="col-12">
            <h1 class="display-6 fw-bold"><i class="bi bi-receipt me-2"></i>Genel Tahsilat Listesi</h1>
            <p class="text-muted">Modern, hızlı ve mobil uyumlu görünüm — liste, filtre ve dışa aktarma (PDF/Excel).</p>
        </div>
    </div>

    <!-- Controls -->
    <div class="row mb-3">
        <div class="col-lg-8 col-md-12">
            <form method="GET" id="filterForm" class="row g-2 align-items-end">
                <div class="col-sm-6 col-md-3">
                    <label class="form-label small">Başlangıç</label>
                    <input type="date" name="baslangic_tarihi" class="form-control" value="{{ baslangic_tarihi }}">
                </div>
                <div class="col-sm-6 col-md-3">
                    <label class="form-label small">Bitiş</label>
                    <input type="date" name="bitis_tarihi" class="form-control" value="{{ bitis_tarihi }}">
                </div>
                <div class="col-sm-6 col-md-3">
                    <label class="form-label small">Plasiyer</label>
                    <select name="plasiyer" class="form-select">
                        <option value="">Tümü</option>
                        {% for p in plasiyerler %}
                        <option value="{{ p }}" {% if p == plasiyer_filter %}selected{% endif %}>{{ p }}</option>
                        {% endfor %}
                    </select>
                </div>
                <div class="col-sm-6 col-md-3">
                    <label class="form-label small">Teslim Durumu</label>
                    <select name="teslim_durumu" class="form-select">
                        <option value="">Tümü</option>
                        <option value="TESLİM EDİLDİ" {% if teslim_durumu == 'TESLİM EDİLDİ' %}selected{% endif %}>Teslim Edildi</option>
                        <option value="TESLİM EDİLMEDİ" {% if teslim_durumu == 'TESLİM EDİLMEDİ' %}selected{% endif %}>Teslim Edilmedi</option>
                    </select>
                </div>
                <div class="col-12 col-md-12 text-end">
                    <button class="btn btn-primary" type="submit"><i class="bi bi-search me-1"></i>Filtrele</button>
                    <a class="btn btn-outline-secondary" href="{% url 'tahsilat:muhasebe_tahsilat_listesi' %}"><i class="bi bi-x-circle me-1"></i>Temizle</a>
                    {% if tahsilatlar %}
                    <a class="btn btn-outline-danger" href="?{% if baslangic_tarihi %}baslangic_tarihi={{ baslangic_tarihi }}&{% endif %}{% if bitis_tarihi %}bitis_tarihi={{ bitis_tarihi }}&{% endif %}{% if plasiyer_filter %}plasiyer={{ plasiyer_filter }}&{% endif %}export=pdf" target="_blank"><i class="bi bi-file-earmark-pdf me-1"></i>PDF</a>
                    <a class="btn btn-success" href="?{% if baslangic_tarihi %}baslangic_tarihi={{ baslangic_tarihi }}&{% endif %}{% if bitis_tarihi %}bitis_tarihi={{ bitis_tarihi }}&{% endif %}{% if plasiyer_filter %}plasiyer={{ plasiyer_filter }}&{% endif %}export=excel" target="_blank"><i class="bi bi-file-earmark-excel me-1"></i>Excel</a>
                    {% endif %}
                </div>
            </form>
        </div>
        <div class="col-lg-4 col-md-12 text-end d-none d-lg-block">
            <div class="h-100 d-flex align-items-center justify-content-end gap-3">
                <div>
                    <small class="text-muted">Toplam Kayıt</small>
                    <div class="fw-bold">{{ pagination_info.total_count|default:0 }}</div>
                </div>
                <div>
                    <small class="text-muted">Toplam Tutar</small>
                    <div class="fw-bold text-success">{{ toplam_tutar|currency_display }}</div>
                </div>
            </div>
        </div>
    </div>

    <!-- Table -->
    <div class="row">
        <div class="col-12">
            <div class="card">
                <div class="card-body p-0">
                    {% if tahsilatlar %}
                    <div class="table-responsive">
                        <table class="table table-hover mb-0 align-middle">
                            <thead class="table-light">
                                <tr>
                                    <th>#</th>
                                    <th>Tarih</th>
                                    <th>Cari Kod</th>
                                    <th>Cari Ünvan</th>
                                    <th>Tür</th>
                                    <th class="text-end">Tutar</th>
                                    <th>Plasiyer</th>
                                    <th>Durum</th>
                                    <th>Evrak</th>
                                </tr>
                            </thead>
                            <tbody>
                                {% for t in tahsilatlar %}
                                <tr>
                                    <td>{{ t.ID }}</td>
                                    <td>{{ t.Tarih|date:"d.m.Y" }}</td>
                                    <td><code>{{ t.CariKod }}</code></td>
                                    <td title="{{ t.CariUnvan }}">{{ t.CariUnvan|truncatechars:60 }}</td>
                                    <td>{{ t.TahsilatTuru }}</td>
                                    <td class="text-end">{{ t.Tutar|currency_display }}</td>
                                    <td>{{ t.Plasiyer|default:"-" }}</td>
                                    <td>
                                        {% if t.TeslimDurumu == 'TESLİM EDİLDİ' %}
                                            <span class="badge bg-success">Teslim Edildi</span>
                                        {% elif t.TeslimDurumu == 'TESLİM EDİLMEDİ' %}
                                            <span class="badge bg-danger">Teslim Edilmedi</span>
                                        {% else %}
                                            <span class="badge bg-secondary">{{ t.TeslimDurumu|default:'-' }}</span>
                                        {% endif %}
                                    </td>
                                    <td class="text-center">
                                        {% if t.evrak_var %}
                                        <button class="btn btn-sm btn-outline-primary" onclick="evrakGoster('{{ t.evrak_url }}', '{{ t.ID }}')"><i class="bi bi-eye"></i></button>
                                        {% else %}
                                        <span class="text-muted small">Yok</span>
                                        {% endif %}
                                    </td>
                                </tr>
                                {% endfor %}
                            </tbody>
                        </table>
                    </div>
                    {% else %}
                    <div class="p-4 text-center text-muted">
                        <i class="bi bi-inbox" style="font-size: 48px;"></i>
                        <h5 class="mt-3">Tahsilat kaydı bulunamadı</h5>
                        <p>Filtreleri değiştirerek tekrar deneyin.</p>
                    </div>
                    {% endif %}
                </div>
                <div class="card-footer bg-white">
                    <div class="d-flex justify-content-between align-items-center">
                        <div>
                            <small class="text-muted">Sayfa {{ pagination_info.current_page }} / {{ pagination_info.total_pages }}</small>
                        </div>
                        <div>
                            <!-- Simple pagination controls -->
                            <nav>
                                <ul class="pagination pagination-sm mb-0">
                                    {% if pagination_info.has_previous %}
                                    <li class="page-item"><a class="page-link" href="?page={{ pagination_info.previous_page }}">Önceki</a></li>
                                    {% endif %}
                                    <li class="page-item active"><span class="page-link">{{ pagination_info.current_page }}</span></li>
                                    {% if pagination_info.has_next %}
                                    <li class="page-item"><a class="page-link" href="?page={{ pagination_info.next_page }}">Sonraki</a></li>
                                    {% endif %}
                                </ul>
                            </nav>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

