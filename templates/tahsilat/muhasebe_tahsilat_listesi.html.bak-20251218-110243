            `;
            infoItem.innerHTML = '<i class="bi bi-info-circle me-2"></i>Bu kayıt zaten Logo\'da işlendi';
            menu.appendChild(infoItem);
        }
        
        document.body.appendChild(menu);
        
        // Menü boyutunu al ve pozisyonu ayarla
        const menuRect = menu.getBoundingClientRect();
        const viewportWidth = window.innerWidth;
        const viewportHeight = window.innerHeight;
        
        let menuX = event.clientX;
        let menuY = event.clientY;
        
        // Sağa taşma kontrolü
        if (menuX + menuRect.width > viewportWidth) {
            menuX = viewportWidth - menuRect.width - 10;
        }
        
        // Alta taşma kontrolü
        if (menuY + menuRect.height > viewportHeight) {
            menuY = viewportHeight - menuRect.height - 10;
        }
        
        // Sol ve üst sınır kontrolü
        menuX = Math.max(10, menuX);
        menuY = Math.max(10, menuY);
        
        // Pozisyonu ayarla ve görünür yap
        menu.style.left = menuX + 'px';
        menu.style.top = menuY + 'px';
        menu.style.visibility = 'visible';
        
        // Menü dışına tıklandığında kapat
        const closeMenu = (e) => {
            if (!menu.contains(e.target)) {
                menu.remove();
                document.removeEventListener('click', closeMenu);
            }
        };
        
        setTimeout(() => {
            document.addEventListener('click', closeMenu);
        }, 100);
    }
    
    // Logo durumu güncelleme fonksiyonu
    function updateLogoDurumu(tahsilatId) {
        if (!confirm('Bu kaydın durumunu "Logo\'da İşlendi" olarak güncellemek istediğinizden emin misiniz?')) {
            return;
        }
        
        // AJAX ile durum güncelleme isteği gönder
        window.csrfFetch('{% url "tahsilat:update_logo_durumu" %}', {
            method: 'POST',
            headers: {
                'Content-Type': 'application/json'
            },
            body: JSON.stringify({
                tahsilat_id: tahsilatId,
                new_status: "LOGO'DA İŞLENDİ"
            })
        })
        .then(response => response.json())
        .then(data => {
            if (data.success) {
                alert(data.message);
                // Sayfayı yenile
                window.location.reload();
            } else {
                alert('Güncelleme hatası: ' + (data.message || 'Bilinmeyen hata'));
            }
        })
        .catch(error => {
            console.error('Error:', error);
            alert('Sunucu hatası oluştu');
        });
    }

    // Checkbox değişikliklerini dinle
    function updateSelectAllState() {
        const checkboxes = document.querySelectorAll('.tahsilat-checkbox');
        const selectAllCheckbox = document.getElementById('selectAll');
        const checkedCheckboxes = document.querySelectorAll('.tahsilat-checkbox:checked');
        
        // Tümünü seç durumunu güncelle
        if (checkedCheckboxes.length === 0) {
            selectAllCheckbox.indeterminate = false;
            selectAllCheckbox.checked = false;
        } else if (checkedCheckboxes.length === checkboxes.length) {
            selectAllCheckbox.indeterminate = false;
            selectAllCheckbox.checked = true;
        } else {
            selectAllCheckbox.indeterminate = true;
        }

        // Satır renklerini güncelle
        checkboxes.forEach(checkbox => {
            const row = checkbox.closest('tr');
            if (checkbox.checked) {
                row.classList.add('selected');
            } else {
                row.classList.remove('selected');
            }
        });
    }

    // Tümünü seç/seçme
    function toggleSelectAll() {
        const selectAllCheckbox = document.getElementById('selectAll');
        const checkboxes = document.querySelectorAll('.tahsilat-checkbox');
        
        checkboxes.forEach(checkbox => {
            checkbox.checked = selectAllCheckbox.checked;
            const row = checkbox.closest('tr');
            if (selectAllCheckbox.checked) {
                row.classList.add('selected');
            } else {
                row.classList.remove('selected');
            }
        });
    }

